<odoo>
  <data>

    <!-- FORM VIEW -->
    <record id="estate_form_view" model="ir.ui.view">
      <field name="name">estate.property.form</field>
      <field name="model">estate.property</field>
      <field name="arch" type="xml">
        <form>
           <sheet>
            <group>
              <group>
                <field name="name" />
                <field name="description"/>
                <field name="postcode"/>
              </group>
              <group>
                <field name="date_availability"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
              </group>
              <group>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <field name="garage"/>
                <field name="garden_area"/>
              </group>
            </group>
            </sheet>

        </form>
      </field>
    </record>

    <!-- TREE VIEW -->
   <record id="estate_tree_view" model="ir.ui.view">
  <field name="name">estate.property.tree</field>
  <field name="model">estate.property</field>
  <field name="arch" type="xml">
    <list>
      <field name="name"/>
      <field name="expected_price"/>
    </list>
  </field>
</record>


    <!-- ACTION -->
    <record id="action_estate_property" model="ir.actions.act_window">
      <field name="name">Properties</field>
      <field name="res_model">estate.property</field>
      <field name="view_mode">list,form</field> <!-- fixed -->
    </record>

    <!-- MENUS -->
    <menuitem id="menu_estate_root"
              name="Real Estate"
              sequence="10"/>

    <menuitem id="menu_estate_main"
              name="Properties"
              parent="menu_estate_root"
              sequence="20"/>

    <menuitem id="menu_estate_property_items"
              name="All Listings"
              parent="menu_estate_main"
              action="action_estate_property"
              sequence="30"/>

  </data>
</odoo>