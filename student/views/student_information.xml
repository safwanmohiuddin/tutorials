<odoo>
    <data>

        <record id = "information_form_view" model = "ir.ui.view">
            <field name = "name">student.information.form</field>
            <field name = "model">student.information</field>
            <field name = "arch" type = "xml">
                   <form>
                       <sheet>
                           <group>
                               <group>
                               <field name = "name"/>
                               <field name = "student_id"/>
                               <field name = "age"/>
                               </group>
                               <group>
                               <field name = "date_of_birth"/>
                               <field name = "guardian_id"/>
                               <field name = "course_id"/>
                               </group>
                           </group>
                       </sheet>
                   </form>
        </field>
        </record>

        <record id = "information_tree_view" model = "ir.ui.view">
            <field name = "name">student.information.tree</field>
            <field name = "model">student.information</field>
            <field name = "arch" type = "xml">
                <list>
                    <field name = "name"/>
                    <field name = "student_id"/>
                    <field name = "age"/>
                </list>
            </field>
        </record>

        <record id ="information_action" model = "ir.actions.act_window">
            <field name = "name">Student Information</field>
            <field name = "res_model">student.information</field>
            <field name = "view_mode">list,form</field>
        </record>

    </data>
</odoo>